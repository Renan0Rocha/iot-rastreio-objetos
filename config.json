{
  "serial": {
    "port": "/dev/ttyACM0",
    "baud_rate": 115200,
    "timeout": 1
  },
  "api": {
    "base_url": "http://localhost:8085",
    "route": "/api/leitura",
    "timeout": 5,
    "headers": {
      "Content-Type": "application/json",
      "User-Agent": "RFID-Bridge/2.0"
    },
    "payload_fields": [
      "tag_codigo",
      "lido_em",
      "rssi",
      "payload_json",
      "fk_id_dispositivo"
    ],
    "dispositivo_id": 1
  },
  "debug": {
    "enabled": true,
    "show_payload": true
  }
}
