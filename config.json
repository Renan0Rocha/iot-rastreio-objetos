{
  "serial": {
    "port": "/dev/ttyACM0",
    "baud_rate": 115200,
    "timeout": 1
  },
  "api": {
    "base_url": "http://localhost:3000",
    "route": "/api/rfid",
    "timeout": 5,
    "headers": {
      "Content-Type": "application/json",
      "User-Agent": "RFID-Bridge/2.0"
    },
    "payload_fields": [
      "reader",
      "uid_hex",
      "timestamp_ms"
    ]
  },
  "debug": {
    "enabled": true,
    "show_payload": true
  }
}
